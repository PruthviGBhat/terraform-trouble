# =============================================================================
# CLOUDKITCHEN – .gitignore
# =============================================================================

# ── Terraform state (NEVER commit – contains plaintext secrets) ───────────
*.tfstate
*.tfstate.*
*.tfstate.backup

# ── Terraform working directories ─────────────────────────────────────────
.terraform/
.terraform.lock.hcl

# ── Variable files that may contain secrets ───────────────────────────────
*.tfvars
*.tfvars.json
# Exception: keep the example file
!terraform.tfvars.example

# ── Terraform plan output ─────────────────────────────────────────────────
*.tfplan
tfplan

# ── Crash logs ────────────────────────────────────────────────────────────
crash.log
crash.*.log

# ── Override files ────────────────────────────────────────────────────────
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── IDE & OS artifacts ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── SSH keys (just in case) ───────────────────────────────────────────────
*.pem
*.key
*.rsa

# ── Python (for Lambda functions) ────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
lambda/*.zip

# ── Node.js (frontend node_modules are large) ────────────────────────────
cloudkitchen-aws/frontend/node_modules/
cloudkitchen-aws/frontend/build/

# ── Java build artifacts ──────────────────────────────────────────────────
cloudkitchen-aws/backend/**/target/
